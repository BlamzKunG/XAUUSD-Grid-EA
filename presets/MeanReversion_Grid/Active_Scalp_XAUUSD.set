;============================================================
; XAUUSD Adaptive Mean-Reversion Grid EA - Active Scalp
; Focus: Maximum trading activity, rapid turnover
;============================================================
InpMagicNumber=20250301
InpTradeComment=XAU_MR_Act
InpAllowNewEntries=true

;--- Multi-TF Filters (Active)
InpEntryTF=15 ; PERIOD_M15
InpTrendTF=16385 ; PERIOD_H1
InpEMA_Fast=50
InpEMA_Slow=200
InpMaxEMADiffPoints=3000
InpADX_Period=14
InpMaxADXForEntry=32.0
InpTrendEscapeADX=36.0
InpRSI_Period=14
InpBuyRSI_Level=40.0
InpSellRSI_Level=60.0
InpBB_Period=20
InpBB_Deviation=1.6

;--- Dynamic Grid Engine
InpATR_Period=14
InpGridATRMultiplier=1.2
InpMinGridStepUSD=2.5
InpMaxGridStepUSD=8.0
InpMaxGridLevels=5

;--- Lot Management
InpLotStrategy=1
InpInitialLot=0.01
InpLotMultiplier=1.15
InpMaxSingleLot=0.05
InpMaxExposureLots=0.15
InpRiskPerBasketPct=3.0

;--- Basket TP
InpTPMode=0
InpBasketTPPercent=0.30
InpBasketTPUSD=8.0
InpBasketTP_ATR_Factor=0.20
InpUseBasketTrailing=true
InpTrailStartUSD=6.0
InpTrailStepUSD=2.0

;--- Risk Management
InpEquityStopPercent=8.0
InpUseEmergencyATR_SL=true
InpEmergencySL_ATR_Mult=3.5
InpUseTrendEscape=true
InpTrendEscapeLossCutUSD=40.0
InpMarginLevelFreeze=200.0
InpMarginEmergencyCut=120.0
InpDailyLossLimitPct=3.0
InpDailyProfitTargetPct=2.0
InpCooldownMinutes=5

;--- Time & Spread Filters
InpUseSpreadFilter=true
InpMaxSpreadPoints=50
InpUseTimeFilter=true
InpStartHour=6
InpEndHour=22
InpAvoidAsianNight=false
InpFridayCloseEarly=true
InpFridayStopHour=20
InpShowDashboard=true
