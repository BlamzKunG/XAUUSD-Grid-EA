;============================================================
; XAUUSD Adaptive Mean-Reversion Grid EA - Standard ($2,000)
; Focus: Balanced risk-return, dynamic step, mild multiplier
;============================================================
InpMagicNumber=20250301
InpTradeComment=XAU_MR_2K
InpAllowNewEntries=true

;--- Multi-TF Filters
InpEntryTF=15 ; PERIOD_M15
InpTrendTF=16385 ; PERIOD_H1
InpEMA_Fast=50
InpEMA_Slow=200
InpMaxEMADiffPoints=1500
InpADX_Period=14
InpMaxADXForEntry=22.0
InpTrendEscapeADX=28.0
InpRSI_Period=14
InpBuyRSI_Level=30.0
InpSellRSI_Level=70.0
InpBB_Period=20
InpBB_Deviation=2.0

;--- Dynamic Grid Engine
InpATR_Period=14
InpGridATRMultiplier=1.5
InpMinGridStepUSD=4.0
InpMaxGridStepUSD=12.0
InpMaxGridLevels=5

;--- Lot Management
InpLotStrategy=1 ; Mild Multiplier
InpInitialLot=0.01
InpLotMultiplier=1.15
InpMaxSingleLot=0.03
InpMaxExposureLots=0.10
InpRiskPerBasketPct=3.0

;--- Basket TP
InpTPMode=0 ; Hybrid
InpBasketTPPercent=0.50
InpBasketTPUSD=15.0
InpBasketTP_ATR_Factor=0.30
InpUseBasketTrailing=true
InpTrailStartUSD=10.0
InpTrailStepUSD=3.0

;--- Risk Management
InpEquityStopPercent=7.0
InpUseEmergencyATR_SL=true
InpEmergencySL_ATR_Mult=3.0
InpUseTrendEscape=true
InpTrendEscapeLossCutUSD=40.0
InpMarginLevelFreeze=250.0
InpMarginEmergencyCut=130.0
InpDailyLossLimitPct=3.0
InpDailyProfitTargetPct=1.5
InpCooldownMinutes=30

;--- Time & Spread Filters
InpUseSpreadFilter=true
InpMaxSpreadPoints=40
InpUseTimeFilter=true
InpStartHour=8
InpEndHour=20
InpAvoidAsianNight=true
InpFridayCloseEarly=true
InpFridayStopHour=18
InpShowDashboard=true
